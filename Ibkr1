import streamlit as st
import pandas as pd
import requests

st.title("📊 IBKR Dashboard PRO")

@st.cache_data
def cargar_datos():
    url = "1493224"
    r = requests.get(url)
    
    with open("ibkr.xml", "wb") as f:
        f.write(r.content)

    df = pd.read_xml("ibkr.xml")
    return df

df = cargar_datos()

st.write("Datos cargados:", df.shape)

# KPIs básicos
if "marketValue" in df.columns:
    st.metric("Valor cartera", round(df["marketValue"].sum(),2))

# Opciones
if "assetCategory" in df.columns:
    opciones = df[df["assetCategory"]=="OPT"]
    st.write("Opciones:", opciones)
